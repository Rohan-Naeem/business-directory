# Public site URL used for metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://nexusbiz.directory

# Supabase (PostgreSQL) — copy this file to .env.local and fill in real values.
# Never commit .env.local or real keys to GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (set in Vercel only, never commit real values)
ADMIN_USERNAME=
ADMIN_PASSWORD=
